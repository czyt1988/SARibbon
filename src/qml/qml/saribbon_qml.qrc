<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/SARibbon">
        <file>RibbonPanel.qml</file>
        <file>RibbonMenu.qml</file>
        <file>RibbonToolButton.qml</file>
        <file>RibbonBar.qml</file>
        <file>RibbonTab.qml</file>
        <file>RibbonCategory.qml</file>
        <file>RibbonCategoryScroll.qml</file>
        <file>RibbonControlContainer.qml</file>
        <file>RibbonGallery.qml</file>
        <file>RibbonSeparator.qml</file>
        <file>RibbonColorGrid.qml</file>
        <file>RibbonColorNoneMark.qml</file>
        <file>RibbonColorMenu.qml</file>
        <file>RibbonColorToolButton.qml</file>
    </qresource>
    <!-- Shared theme palette data (the same on-disk JSONs the widgets module
         compiles in): a QML-only app must resolve theme tokens without
         SARibbonWidgets, so the QML module registers them under the identical
         resource prefix. Identical files -> duplicate registrations in a
         mixed app resolve to identical content. -->
    <qresource prefix="/SARibbonTheme/resource">
        <file alias="palettes/office2016-blue.json">../../core/resource/palettes/office2016-blue.json</file>
        <file alias="palettes/office2016-green.json">../../core/resource/palettes/office2016-green.json</file>
        <file alias="palettes/office2016-dark.json">../../core/resource/palettes/office2016-dark.json</file>
        <file alias="palettes/office2021-blue.json">../../core/resource/palettes/office2021-blue.json</file>
        <file alias="palettes/office2021-green.json">../../core/resource/palettes/office2021-green.json</file>
        <file alias="palettes/office2021-dark.json">../../core/resource/palettes/office2021-dark.json</file>
        <file alias="palettes/dark-default.json">../../core/resource/palettes/dark-default.json</file>
        <file alias="palettes/dark2-default.json">../../core/resource/palettes/dark2-default.json</file>
        <file alias="palettes/win7-default.json">../../core/resource/palettes/win7-default.json</file>
        <file alias="palettes/office2013-default.json">../../core/resource/palettes/office2013-default.json</file>
    </qresource>
</RCC>
