@PACKAGE_INIT@
# 在任何 find_dependency 之前快照本包前缀：后续 find_dependency(Qt...) 会加载
# Qt6Config.cmake，其 @PACKAGE_INIT@ 展开会把 PACKAGE_PREFIX_DIR 重算成 Qt 的前缀，
# 覆盖本包的值（consumer 实测踩坑）
set(_saribbon_prefix "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
# REQUIRED 必带（QWK QWindowKitConfig.cmake.in:5-6 同款）：否则 Qt 缺失时
# find_dependency 静默返回，错误延迟到 Targets 引用 Qt6::Core 时才爆出，难排查
find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Core Gui REQUIRED)
if(@SARIBBON_BUILD_WIDGETS@)
    find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Widgets Svg REQUIRED)
endif()
if(@SARIBBON_BUILD_QML@)
    # 命令式单轨下 Qml 组件需要 Quick/Qml/QuickControls2——无任何 qmldir/qmltypes 安装物
    find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Qml Quick QuickControls2 REQUIRED)
endif()
# frameless：SARibbon::Widgets 链接 QWindowKit::Widgets；SARibbonQml 强制
# 开启 frameless 并链接 QWindowKit::Quick（导出 target 的 INTERFACE_LINK_LIBRARIES
# 引用了这些名字，消费端必须先找到 QWindowKit）
set(_saribbon_qwk_components)
if(@_SARIBBON_USE_FRAMELESS_LIB@)
    list(APPEND _saribbon_qwk_components Widgets)
endif()
if(@SARIBBON_BUILD_QML@)
    list(APPEND _saribbon_qwk_components Quick)
endif()
if(_saribbon_qwk_components)
    # 本地安装布局：QWindowKit 与 SARibbon 同前缀安装（bin_qtX 编译器隔离目录）。
    # 用户未显式指定 QWindowKit_DIR 时直接把同前缀候选传给 find_package 的
    # 搜索路径（HINTS）。（_saribbon_prefix 是 @PACKAGE_INIT@ 后的快照，
    # 见文件开头注释）
    set(_saribbon_qwk_hint "")
    if(NOT QWindowKit_DIR AND EXISTS "${_saribbon_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/QWindowKit")
        set(_saribbon_qwk_hint "${_saribbon_prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/QWindowKit")
    endif()
    if(_saribbon_qwk_hint)
        find_dependency(QWindowKit REQUIRED ${_saribbon_qwk_components} HINTS ${_saribbon_qwk_hint})
    else()
        find_dependency(QWindowKit REQUIRED ${_saribbon_qwk_components})
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/SARibbonTargets.cmake")
# 组件语义：COMPONENTS Core/Widgets/Qml 映射到 target 存在性
set(_saribbon_supported_components Core Widgets Qml)
foreach(_comp ${SARibbon_FIND_COMPONENTS})
    if(NOT _comp IN_LIST _saribbon_supported_components)
        set(SARibbon_FOUND FALSE)
        set(SARibbon_NOT_FOUND_MESSAGE "Unsupported component: ${_comp}")
    elseif(NOT TARGET SARibbon::${_comp})
        set(SARibbon_${_comp}_FOUND FALSE)
    else()
        set(SARibbon_${_comp}_FOUND TRUE)
    endif()
endforeach()
check_required_components(SARibbon)
